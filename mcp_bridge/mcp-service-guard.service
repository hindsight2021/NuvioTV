[Unit]
Description=Home Assistant switches for Pi MCP service groups
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/nuvio-ha-mcp.env
ExecStart=/opt/nuvio-mcp-bridge/.venv/bin/python /opt/nuvio-mcp-bridge/mcp_service_guard.py
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
